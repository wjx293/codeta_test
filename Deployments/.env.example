# Deployments 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=template_order_db
JWT_SECRET=template-mall-secret-key

# B 端认证：mock（本地演示）| wps（WPS OAuth）
AUTH_PROVIDER=wps
ADMIN_USER_IDS=your_wps_user_id

# WPS OAuth（AUTH_PROVIDER=wps 时必填）
WPS_CLIENT_ID=AK20230207WTGKYW
WPS_CLIENT_SECRET=
WPS_REDIRECT_URI=http://localhost:3001/api/auth/callback
WPS_SCOPE=kso.user_base.read
WPS_KSO_SIGN_ENABLED=false
FRONTEND_HOME_URL=http://localhost:3001/

# 阿里云 OSS（上传/下载，生产必填）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
STS_ROLE_ARN=
STS_SESSION_NAME=template-mall-admin
