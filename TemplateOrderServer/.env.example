# TemplateOrderServer 环境变量配置模板
# 复制为 .env 后修改实际值

# gRPC 端口
GRPC_PORT=9001

# MySQL 连接串
# 格式：user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai
MYSQL_DSN=root:root123456@tcp(127.0.0.1:3306)/template_order_db?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai

# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# Kafka
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=template-pay-events
KAFKA_GROUP_ID=template-order-consumer-group

# PayWebServer 地址
PAY_WEB_SERVER_URL=http://127.0.0.1:8083

# OSS 配置（不使用时留空）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=