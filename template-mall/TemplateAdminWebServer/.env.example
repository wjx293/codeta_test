# TemplateAdminWebServer 环境变量

# HTTP
HTTP_PORT=8081

# gRPC
GRPC_TARGET=localhost:9001

# Auth Provider: wps | mock
AUTH_PROVIDER=wps

# WPS OAuth2（CL-1）
WPS_CLIENT_ID=AK20230207WTGKYW
WPS_CLIENT_SECRET=
WPS_REDIRECT_URI=http://localhost:3001/api/auth/callback
WPS_SCOPE=kso.user_base.read
WPS_AUTH_URL=https://openapi.wps.cn/oauth2/auth
WPS_TOKEN_URL=https://openapi.wps.cn/oauth2/token
WPS_USERINFO_URL=https://openapi.wps.cn/v7/users/current
# 开发者后台 > 安全设置 > 接口签名 开启时设为 true
WPS_KSO_SIGN_ENABLED=false

# 管理员白名单（逗号分隔的 WPS user_id）
ADMIN_USER_IDS=10001,10002

# 前端首页（OAuth 回调成功后跳转）
FRONTEND_HOME_URL=http://localhost:3001/

# Mock Auth（AUTH_PROVIDER=mock 时使用）
MOCK_ADMIN_USER_ID=10001
MOCK_ADMIN_NAME=MockAdmin

# OSS（STS + HeadObject）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# STS Role（配置 OSS 后必填：服务端 AssumeRole，前端仅收临时凭证）
STS_ROLE_ARN=acs:ram::<account-id>:role/template-mall-sts-role
STS_SESSION_NAME=template-mall-admin
